# --- Google OAuth 2.0 (production Render authentication) ---
# Create an OAuth client in Google Cloud. Run scripts/getGoogleRefreshToken.js once
# locally to obtain the refresh token, then store the values in Render secrets.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
SPREADSHEET_ID=your-google-spreadsheet-id

# --- RapidAPI (JSearch) ---
RAPIDAPI_KEY=your-rapidapi-key-here

# --- Adzuna ---
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=gb

# --- Remotive: no API key required ---

# --- Groq ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_RETRY_MODEL=openai/gpt-oss-20b

# --- Behavior ---
AI_CALL_DELAY_MS=12000
DAILY_RUN_HOUR=8
PORT=3000

# --- Security / API ---
MANUAL_TRIGGER_TOKEN=replace-with-a-long-random-value
FRONTEND_ORIGIN=http://localhost:5173
